# Backend Configuration
PORT=8000
ENV=development

# Database Settings
DATABASE_URL=postgresql://dr_user:dr_password_2026@localhost:5432/dr_screening_db

# Security Settings
SECRET_KEY=yoursecretkeyherechangeitinproduction2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PATIENT_DEFAULT_PASSWORD=benhnhan

# AI Services Integration
AI_GRADING_SERVICE_URL=local
# Đặt thành "local" để bật 3 mô hình Attention U-Net (MA/HE/EX) trực tiếp trong Backend.
# Đặt thành "disabled" để tắt segmentation (fallback an toàn).
# Đặt thành http://... để gọi microservice bên ngoài.
AI_SEGMENTATION_SERVICE_URL=local
AI_REQUEST_TIMEOUT_SECONDS=120

# Server-side clinical report drafting (never expose this value to React/VITE_*).
# GEMINI_API_KEYS is also accepted for compatibility with existing deployments.
GEMINI_API_KEY=replace_with_a_new_server_side_key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_OUTPUT_TOKENS=16384

# Cloudinary fundus image storage (server-side only)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=dr-diagnostic-system/fundus

# Local RETFound-DINOv2 grading model
DR_MODEL_PATH=checkpoint-best.pth
DR_FEWSHOT_MODEL_PATH=best-fewshot.pth
# grading | fewshot
DR_DEFAULT_MODEL=grading
DR_DEVICE=auto
DR_PREPROCESS_ENHANCE=0
DR_MAX_UPLOAD_BYTES=20971520

# Lesion Segmentation Checkpoints (Attention U-Net MA/HE/EX – IDRiD)
LESION_MA_CHECKPOINT=checkpoints/idrid_MA/best-checkpoint-epoch=17-val_dice=0.0305.ckpt
LESION_HE_CHECKPOINT=checkpoints/idrid_HE/best-checkpoint-epoch=70-val_dice=0.0272.ckpt
LESION_EX_CHECKPOINT=checkpoints/idrid_EX/best-checkpoint-epoch=64-val_dice=0.0414.ckpt
LESION_DEVICE=auto
